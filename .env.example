# Copy to .env.local and fill in from docs/google-setup.md.
# .env.local is gitignored; this file is not — never put real values here.

# Desktop OAuth client (step 4). Used by the Tauri shell AND browser dev,
# both via a 127.0.0.1 loopback redirect.
VITE_GOOGLE_DESKTOP_CLIENT_ID=
VITE_GOOGLE_DESKTOP_CLIENT_SECRET=

# Android OAuth client (step 5). See docs/google-setup.md and docs/android-setup.md.
VITE_GOOGLE_ANDROID_CLIENT_ID=

# Supabase project (note sync + evergreen tasks, docs/UPDATES.md §1 and §2).
# The URL and publishable key are not secrets — they're safe to ship in the
# built app, the way Supabase's own docs describe. Row Level Security, keyed
# off the Google ID token via signInWithIdToken, is what actually protects
# the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
