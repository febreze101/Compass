# Copy to .env.local and fill in from docs/google-setup.md.
# .env.local is gitignored; this file is not — never put real values here.

# Desktop OAuth client (step 4). Used by the Tauri shell AND browser dev,
# both via a 127.0.0.1 loopback redirect.
VITE_GOOGLE_DESKTOP_CLIENT_ID=
VITE_GOOGLE_DESKTOP_CLIENT_SECRET=

# Android OAuth client (step 5). Leave empty until Android Studio is installed.
VITE_GOOGLE_ANDROID_CLIENT_ID=
